{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++20 (debug)",
            "type": "cppbuild",
            "command": "C:\\msys64\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-g",
                "-Wall",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run (with input.txt if exists)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if exist \"${fileDirname}\\input.txt\" ( \"${fileDirname}\\${fileBasenameNoExtension}.exe\" < \"${fileDirname}\\input.txt\" ) else ( \"${fileDirname}\\${fileBasenameNoExtension}.exe\" )"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}